<Window
    x:Class="WinUIDesigner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIDesigner.App">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ToolboxColumn" Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Toolbox -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="Toolbox" FontWeight="Bold" Margin="0,0,0,8" />
                <Button Content="Button" Tag="Button" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="TextBlock" Tag="TextBlock" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="TextBox" Tag="TextBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="CheckBox" Tag="CheckBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="ComboBox" Tag="ComboBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="Image" Tag="Image" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="StackPanel" Tag="StackPanel" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="Grid" Tag="Grid" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
            </StackPanel>
        </Border>

        <!-- Draggable splitter: Toolbox <-> Center -->
        <local:SplitterThumb x:Name="ToolboxSplitter" Grid.Column="1" Width="8" Background="#FFE0E0E0" HorizontalAlignment="Stretch" />

        <!-- Center: design surface (pasteboard) above, XAML source view below -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DesignSurfaceRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="XamlSourceRow" Height="220" />
            </Grid.RowDefinitions>

            <!-- Pasteboard: gray background behind the page, like the WPF/VS designer's design
                 tab background outside the window's own bounds. -->
            <Border Grid.Row="0" Background="#FFE6E6E6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- The page itself: white and bordered so it reads as sitting on top of the pasteboard. -->
                        <Border
                            x:Name="DesignSurfaceHost"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="#FFBFBFBF"
                            BorderThickness="1" />

                        <!-- Selection adorner overlay: same Margin/alignment as DesignSurfaceHost so their
                             local (0,0) coincide, letting TransformToVisual(DesignSurfaceHost) bounds be
                             used directly as Canvas.Left/Top here. Not hit-test-disabled at the Canvas
                             level (unlike M3) since the resize handles now need real pointer input; the
                             decorative pieces (rectangle/label) opt out individually instead. -->
                        <Canvas
                            x:Name="AdornerCanvas"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Rectangle
                                x:Name="SelectionRectangle"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Stroke="#FF5B7C99"
                                StrokeThickness="1"
                                StrokeDashArray="4,2"
                                Fill="Transparent" />
                            <Border
                                x:Name="SelectionLabel"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Background="#FFE4EEF6"
                                BorderBrush="#FF5B7C99"
                                BorderThickness="1"
                                Padding="4,1">
                                <TextBlock x:Name="SelectionLabelText" FontSize="11" Foreground="#FF1F3A52" />
                            </Border>

                            <!-- Resize handles: 4 corners + 4 edge midpoints, VS-style small squares.
                                 local:ResizeHandle (not a plain Rectangle) so hover can show a resize
                                 cursor - see research/17-resize-handle-hover-cursor.md. -->
                            <local:ResizeHandle x:Name="HandleNW" Tag="NW" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleN" Tag="N" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleNE" Tag="NE" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleW" Tag="W" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleE" Tag="E" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleSW" Tag="SW" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleS" Tag="S" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleSE" Tag="SE" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Draggable splitter: Design surface <-> XAML source -->
            <local:SplitterThumb x:Name="DesignXamlSplitter" Grid.Row="1" Height="8" Background="#FFE0E0E0" VerticalAlignment="Stretch" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,8,8,4">
                    <TextBlock Text="XAML Source" FontWeight="Bold" VerticalAlignment="Center" />
                    <!-- Collapsed until SetXamlSourceError(non-null) shows it - a second, harder-to-miss
                         cue than the Errors tab alone (see research/23-xaml-error-tabs.md). Clicking it
                         jumps straight to the Errors tab. -->
                    <Button
                        x:Name="XamlSourceWarningButton"
                        Click="XamlSourceWarningButton_Click"
                        Visibility="Collapsed"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="This document has a XAML error - see the Errors tab">
                        <FontIcon Glyph="&#xE783;" Foreground="Red" FontSize="14" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBox
                        x:Name="XamlSourceView"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        Margin="8"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        LostFocus="XamlSourceView_LostFocus"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <ScrollViewer x:Name="XamlErrorsPanel" Visibility="Collapsed" Margin="8">
                        <TextBlock x:Name="XamlErrorsText" Foreground="Red" TextWrapping="Wrap" FontFamily="Consolas" />
                    </ScrollViewer>
                </Grid>

                <!-- Tab strip goes BELOW its content (Fabrice's ask), unlike a normal top-tabbed
                     control - WinUI's TabView always puts headers on top with no supported way to
                     move them, so this is two plain Buttons with manually managed selected/error
                     styling (UpdateXamlPaneTabButtonVisuals) rather than a real tab control. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="1" BorderBrush="Gray" BorderThickness="0,1,0,0">
                    <Button x:Name="SourceTabButton" Content="Source" Click="SourceTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" />
                    <Button x:Name="ErrorsTabButton" Content="Errors" Click="ErrorsTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: file panel + property grid -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FilePanelRow" Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PropertiesRow" Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="8" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="File" FontWeight="Bold" Margin="0,0,0,6" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
                    <Button x:Name="NewButton" Click="NewButton_Click" Padding="6,4" ToolTipService.ToolTip="New File">
                        <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                    </Button>
                    <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Padding="6,4" ToolTipService.ToolTip="Open Folder...">
                        <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                    </Button>
                    <Button x:Name="OpenButton" Click="OpenButton_Click" Padding="6,4" ToolTipService.ToolTip="Open File...">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    </Button>
                    <Button x:Name="SaveButton" Click="SaveButton_Click" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="Save">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                    <Button x:Name="RecentButton" Padding="6,4" ToolTipService.ToolTip="Recent Files and Folders">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="RecentFlyout" Placement="Bottom" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TreeView
                    x:Name="FileTreeView"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="FileTreeView_SelectionChanged"
                    DoubleTapped="FileTreeView_DoubleTapped" />

                <TextBlock x:Name="CurrentFileText" Grid.Row="3" Text="(no file open)" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,6,0,0" />
            </Grid>

            <!-- Draggable splitter: File panel <-> Properties -->
            <local:SplitterThumb x:Name="FilePropertiesSplitter" Grid.Row="1" Height="8" Background="#FFE0E0E0" VerticalAlignment="Stretch" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="8" Spacing="4">
                    <TextBlock Text="Properties" FontWeight="Bold" />
                    <TextBlock x:Name="SelectionSummaryText" Text="(no selection)" Foreground="Gray" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyGridPanel" Padding="8,0,8,8" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
