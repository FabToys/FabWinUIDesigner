<Window
    x:Class="WinUIDesigner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Toolbox -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="Toolbox" FontWeight="Bold" Margin="0,0,0,8" />
                <Button Content="Button" Tag="Button" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="TextBlock" Tag="TextBlock" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="TextBox" Tag="TextBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="CheckBox" Tag="CheckBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="ComboBox" Tag="ComboBox" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="Image" Tag="Image" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="StackPanel" Tag="StackPanel" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
                <Button Content="Grid" Tag="Grid" Click="ToolboxItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,6" />
            </StackPanel>
        </Border>

        <!-- Center: design surface (pasteboard) above, XAML source view below -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Pasteboard: gray background behind the page, like the WPF/VS designer's design
                 tab background outside the window's own bounds. -->
            <Border Grid.Row="0" Background="#FFE6E6E6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- The page itself: white and bordered so it reads as sitting on top of the pasteboard. -->
                        <Border
                            x:Name="DesignSurfaceHost"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="#FFBFBFBF"
                            BorderThickness="1" />

                        <!-- Selection adorner overlay: same Margin/alignment as DesignSurfaceHost so their
                             local (0,0) coincide, letting TransformToVisual(DesignSurfaceHost) bounds be
                             used directly as Canvas.Left/Top here. Not hit-test-disabled at the Canvas
                             level (unlike M3) since the resize handles now need real pointer input; the
                             decorative pieces (rectangle/label) opt out individually instead. -->
                        <Canvas
                            x:Name="AdornerCanvas"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Rectangle
                                x:Name="SelectionRectangle"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Stroke="#FF5B7C99"
                                StrokeThickness="1"
                                StrokeDashArray="4,2"
                                Fill="Transparent" />
                            <Border
                                x:Name="SelectionLabel"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Background="#FFE4EEF6"
                                BorderBrush="#FF5B7C99"
                                BorderThickness="1"
                                Padding="4,1">
                                <TextBlock x:Name="SelectionLabelText" FontSize="11" Foreground="#FF1F3A52" />
                            </Border>

                            <!-- Resize handles: 4 corners + 4 edge midpoints, VS-style small squares. -->
                            <Rectangle x:Name="HandleNW" Tag="NW" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleN" Tag="N" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleNE" Tag="NE" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleW" Tag="W" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleE" Tag="E" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleSW" Tag="SW" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleS" Tag="S" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                            <Rectangle x:Name="HandleSE" Tag="SE" Visibility="Collapsed" Width="7" Height="7" Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="XAML Source (read-only)" FontWeight="Bold" Margin="8,8,8,4" />
                <TextBox
                    x:Name="XamlSourceView"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    Margin="8"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- Right: file panel + property grid -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="8" Spacing="8" BorderBrush="Gray" BorderThickness="0,0,0,1" MaxHeight="320">
                <TextBlock Text="File" FontWeight="Bold" />
                <Button x:Name="OpenFolderButton" Content="Open Folder..." Click="OpenFolderButton_Click" HorizontalAlignment="Stretch" />
                <Button x:Name="OpenButton" Content="Open File..." Click="OpenButton_Click" HorizontalAlignment="Stretch" />
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" HorizontalAlignment="Stretch" IsEnabled="False" />
                <TreeView x:Name="FileTreeView" MaxHeight="160" ItemInvoked="FileTreeView_ItemInvoked" />
                <TextBlock x:Name="CurrentFileText" Text="(no file open)" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="8" Spacing="4">
                    <TextBlock Text="Properties" FontWeight="Bold" />
                    <TextBlock x:Name="SelectionSummaryText" Text="(no selection)" Foreground="Gray" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyGridPanel" Padding="8,0,8,8" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
