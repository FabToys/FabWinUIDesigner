<Window
    x:Class="WinUIDesigner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Toolbox -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="Toolbox" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Button" />
                <TextBlock Text="TextBlock" />
                <TextBlock Text="TextBox" />
                <TextBlock Text="CheckBox" />
                <TextBlock Text="ComboBox" />
                <TextBlock Text="Image" />
                <TextBlock Text="StackPanel" />
                <TextBlock Text="Grid" />
            </StackPanel>
        </Border>

        <!-- Center: design surface (pasteboard) above, XAML source view below -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Pasteboard: gray background behind the page, like the WPF/VS designer's design
                 tab background outside the window's own bounds. -->
            <Border Grid.Row="0" Background="#FFE6E6E6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- The page itself: white and bordered so it reads as sitting on top of the pasteboard. -->
                        <Border
                            x:Name="DesignSurfaceHost"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="#FFBFBFBF"
                            BorderThickness="1"
                            Tapped="DesignSurfaceHost_Tapped" />

                        <!-- Selection adorner overlay: same Margin/alignment as DesignSurfaceHost so their
                             local (0,0) coincide, letting TransformToVisual(DesignSurfaceHost) bounds be
                             used directly as Canvas.Left/Top here. -->
                        <Canvas
                            x:Name="AdornerCanvas"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
                            <Rectangle
                                x:Name="SelectionRectangle"
                                Visibility="Collapsed"
                                Stroke="#FF5B7C99"
                                StrokeThickness="1"
                                StrokeDashArray="4,2"
                                Fill="Transparent" />
                            <Border
                                x:Name="SelectionLabel"
                                Visibility="Collapsed"
                                Background="#FFE4EEF6"
                                BorderBrush="#FF5B7C99"
                                BorderThickness="1"
                                Padding="4,1">
                                <TextBlock x:Name="SelectionLabelText" FontSize="11" Foreground="#FF1F3A52" />
                            </Border>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="XAML Source (read-only)" FontWeight="Bold" Margin="8,8,8,4" />
                <TextBox
                    x:Name="XamlSourceView"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    Margin="8"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- Right: file panel + property grid -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="8" Spacing="8" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <TextBlock Text="File" FontWeight="Bold" />
                <Button x:Name="OpenButton" Content="Open..." Click="OpenButton_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="CurrentFileText" Text="(no file open)" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Padding="8" Spacing="4">
                <TextBlock Text="Properties" FontWeight="Bold" />
                <TextBlock x:Name="SelectionSummaryText" Text="(no selection)" Foreground="Gray" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
