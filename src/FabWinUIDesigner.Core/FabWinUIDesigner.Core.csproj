<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FabWinUIDesigner.Core</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x86;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FabWinUIDesigner.Document\FabWinUIDesigner.Document.csproj" />
  </ItemGroup>

  <!-- Property/event grid metadata, and the Toolbox's control list - a loose
       content file copied next to the exe (not embedded), so a property/event/
       toolbox entry can be added by editing the JSON and restarting the app, no rebuild needed. This is static
       app-shipped data read from AppContext.BaseDirectory, not user data, so it doesn't hit the
       unpackaged-app ApplicationData.Current gotcha (it throws without package identity; that was about *writing*
       user state, not reading a file next to the exe). ProjectReference transitively copies a
       referenced project's own CopyToOutputDirectory content into the referencing app's output. -->
  <ItemGroup>
    <Content Include="Metadata\PropertyMetadata.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Metadata\EventMetadata.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
