<Application
    x:Class="FabWinUIDesigner.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Several WinUI controls (e.g. TreeView) resolve their default style/template
                     from here and fail at the native layer without it - most simpler controls
                     (Button, TextBox, ...) happened to tolerate its absence, which is how this
                     went unnoticed until TreeView was added. Standard in every real WinUI3 app;
                     our hand-authored App.xaml (no project template was used)
                     never had it. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
