<ContentDialog
    x:Class="FabWinUIDesigner.App.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OptionsDialog_PrimaryButtonClick">

    <!-- Wider than ContentDialog's 548px default, so file paths have room. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <!-- One section per area, each a heading over label/value rows (label column fixed so the
         values line up across sections). Few enough settings that tabs aren't needed. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MinWidth="560" Padding="0,0,12,0">

            <StackPanel Spacing="8">
                <TextBlock Text="Design surface" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Grid size (px)" VerticalAlignment="Center" />
                    <NumberBox x:Name="GridSizeBox" Grid.Column="1" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" />

                    <CheckBox x:Name="SnapToGridCheckBox" Grid.Row="1" Grid.Column="1" Content="Snap to grid" />

                    <TextBlock Grid.Row="2" Text="New page background" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="NewPageBackgroundBox" Width="160" TextChanged="ColorBox_TextChanged" />
                        <Border x:Name="NewPageBackgroundSwatch" Width="28" Height="28" BorderBrush="Gray" BorderThickness="1" />
                        <DropDownButton x:Name="NewPageBackgroundPickerButton" Content="Pick..." />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="XAML editor" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Font size" VerticalAlignment="Center" />
                    <NumberBox x:Name="EditorFontSizeBox" Grid.Column="1" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" />

                    <TextBlock Grid.Row="1" Text="Background" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="EditorBackgroundBox" Width="160" PlaceholderText="Default" TextChanged="ColorBox_TextChanged" />
                        <Border x:Name="EditorBackgroundSwatch" Width="28" Height="28" BorderBrush="Gray" BorderThickness="1" />
                        <DropDownButton x:Name="EditorBackgroundPickerButton" Content="Pick..." />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Apply typed XAML after (ms)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumberBox x:Name="XamlApplyDelayBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" SmallChange="100" LargeChange="500" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Startup and files" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="ReopenTabsCheckBox" Grid.Column="1" Content="Reopen the tabs open at the last exit" />

                    <TextBlock Grid.Row="1" Text="Recent Files/Folders entries" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumberBox x:Name="RecentListLengthBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Control metadata" FontWeight="SemiBold" />
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                           Text="JSON files listing the Toolbox controls, their properties and their events. Leave empty to use the files shipped with the designer. A file of your own replaces the built-in one entirely." />
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Controls and properties" VerticalAlignment="Center" />
                    <TextBox x:Name="PropertyMetadataBox" Grid.Column="1" />
                    <Button Grid.Column="2" Content="Browse..." Tag="{x:Bind PropertyMetadataBox}" Click="BrowseMetadataButton_Click" />

                    <TextBlock Grid.Row="1" Text="Events" VerticalAlignment="Center" />
                    <TextBox x:Name="EventMetadataBox" Grid.Row="1" Grid.Column="1" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Tag="{x:Bind EventMetadataBox}" Click="BrowseMetadataButton_Click" />
                </Grid>
            </StackPanel>

            <!-- Filled by OptionsDialog_PrimaryButtonClick when a value is invalid; the dialog stays open. -->
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Where these settings live, e.g. to back them up. Selectable so the path can be copied. -->
            <StackPanel Spacing="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <TextBlock Text="These settings are saved in:" Foreground="Gray" FontSize="12" />
                <TextBlock x:Name="SettingsPathText" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <HyperlinkButton Content="Open folder" Padding="0,2" FontSize="12" Click="OpenSettingsFolderButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
