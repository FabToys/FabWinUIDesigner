<Window
    x:Class="FabWinUIDesigner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FabWinUIDesigner.App"
    xmlns:tcb="using:TextControlBoxNS">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ToolboxColumn" Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Main menu. Shortcut text is display-only (KeyboardAcceleratorTextOverride): every
             shortcut is handled in RootGrid_KeyDown alone. Real KeyboardAccelerators on these
             items could fire as well as that handler, and would bypass its guard that leaves
             Ctrl+Z/Y to a focused text field's own undo. -->
        <MenuBar Grid.Row="0" Grid.ColumnSpan="4">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New File" Click="NewButton_Click" KeyboardAcceleratorTextOverride="Ctrl+N">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open File..." Click="OpenButton_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open Folder..." Click="OpenFolderButton_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+O">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save" Click="SaveButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+S">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Save As..." Click="SaveAsMenuItem_Click" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="Recent Files">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="RecentFoldersMenu" Text="Recent Folders" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="ExitMenuItem_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="Undo" Click="UndoButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Z">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="Redo" Click="RedoButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Y">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete" Click="DeleteMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Del">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="DeselectMenuItem" Text="Deselect" Click="DeselectMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Esc" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FormatMenuItem" Text="Format Document" Click="FormatDocumentButton_Click" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E4;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="SnapToGridMenuItem" Text="Snap to Grid" Click="SnapToGridMenuItem_Click" />
                <ToggleMenuFlyoutItem x:Name="AlphabeticalViewMenuItem" Text="Alphabetical Properties" Click="AlphabeticalViewMenuItem_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About FabWinUI Designer" Click="AboutMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Main toolbar: document-level actions, full width across the window like VS's standard
             toolbar. View settings (Snap to Grid, Alphabetical View) stay in their own panels'
             toolbars instead, since they belong to that view rather than to the document.
             Plain icon Buttons rather than a CommandBar, to keep the compact VS look -
             CommandBar's default height and label/overflow behaviour are touch-first. -->
        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#FFF3F3F3" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="NewButton" Click="NewButton_Click" Padding="6,4" ToolTipService.ToolTip="New File (Ctrl+N)">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                </Button>
                <Button x:Name="OpenButton" Click="OpenButton_Click" Padding="6,4" ToolTipService.ToolTip="Open File... (Ctrl+O)">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Padding="6,4" ToolTipService.ToolTip="Open Folder... (Ctrl+Shift+O)">
                    <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_Click" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="Save (Ctrl+S)">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>

                <Border Width="1" Background="Gray" Margin="4,4" />

                <Button x:Name="UndoButton" Click="UndoButton_Click" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button x:Name="RedoButton" Click="RedoButton_Click" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>

                <Border Width="1" Background="Gray" Margin="4,4" />

                <Button x:Name="FormatToolbarButton" Click="FormatDocumentButton_Click" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="Format Document">
                    <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Toolbox - items are built in code (MainWindow.BuildToolbox) from PropertyGridSchema.ToolboxControlTypes, itself read from Metadata/PropertyMetadata.json, instead of one hardcoded Button per control type here. -->
        <Border Grid.Row="2" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel Padding="8" Spacing="4">
                <TextBlock Text="Toolbox" FontWeight="Bold" Margin="0,0,0,8" />
                <StackPanel x:Name="ToolboxItemsPanel" Spacing="4" />
            </StackPanel>
        </Border>

        <!-- Draggable splitter: Toolbox <-> Center -->
        <local:SplitterThumb x:Name="ToolboxSplitter" Grid.Row="2" Grid.Column="1" Width="8" Background="#FFE0E0E0" HorizontalAlignment="Stretch" />

        <!-- Center: design surface (pasteboard) above, XAML source view below -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="DesignSurfaceRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="XamlSourceRow" Height="220" />
            </Grid.RowDefinitions>

            <!-- Design toolbar: icon buttons for design-surface-view settings (as opposed to the
                 XAML Source strip's document operations, e.g. Format). Snap to Grid lives here
                 first; room for future design-view toggles (e.g. alignment guides) alongside it. -->
            <Border Grid.Row="0" Background="#FFF3F3F3" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="SnapToGridToggle"
                        Padding="6"
                        Checked="SnapToGridToggle_Toggled"
                        Unchecked="SnapToGridToggle_Toggled"
                        ToolTipService.ToolTip="Snap to Grid">
                        <FontIcon Glyph="&#xE80A;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Pasteboard: gray background behind the page, like the WPF/VS designer's design
                 tab background outside the window's own bounds. -->
            <Border Grid.Row="1" Background="#FFE6E6E6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- The page itself: white and bordered so it reads as sitting on top of the
                             pasteboard. GridOverlay (below) draws on top of it, not behind it - the
                             loaded document's own root commonly sets its own opaque Background (e.g.
                             samples/SimplePage.xaml's root Canvas is Background="White"), which would
                             otherwise paint straight over any dots placed behind this Border. -->
                        <Border
                            x:Name="DesignSurfaceHost"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="White"
                            BorderBrush="#FFBFBFBF"
                            BorderThickness="1" />

                        <!-- Snap-to-grid dot overlay: sits on top of DesignSurfaceHost (see above) so
                             its dots are always visible regardless of the loaded document's own root
                             background; not hit-test-visible so clicks/drags still reach the design
                             surface underneath. Dots are plain Rectangles added/cleared in code
                             (RenderGridOverlay), sized to match DesignSurfaceHost via its SizeChanged
                             handler. -->
                        <Canvas
                            x:Name="GridOverlay"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Background="Transparent" />

                        <!-- Selection adorner overlay: same Margin/alignment as DesignSurfaceHost so their
                             local (0,0) coincide, letting TransformToVisual(DesignSurfaceHost) bounds be
                             used directly as Canvas.Left/Top here. Not hit-test-disabled at the Canvas
                             level (unlike earlier versions) since the resize handles now need real pointer input; the
                             decorative pieces (rectangle/label) opt out individually instead. -->
                        <Canvas
                            x:Name="AdornerCanvas"
                            Margin="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Rectangle
                                x:Name="SelectionRectangle"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Stroke="#FF5B7C99"
                                StrokeThickness="1"
                                StrokeDashArray="4,2"
                                Fill="Transparent" />
                            <Border
                                x:Name="SelectionLabel"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Background="#FFE4EEF6"
                                BorderBrush="#FF5B7C99"
                                BorderThickness="1"
                                Padding="4,1">
                                <TextBlock x:Name="SelectionLabelText" FontSize="11" Foreground="#FF1F3A52" />
                            </Border>

                            <!-- Resize handles: 4 corners + 4 edge midpoints, VS-style small squares.
                                 local:ResizeHandle (not a plain Rectangle) so hover can show a resize
                                 cursor. -->
                            <local:ResizeHandle x:Name="HandleNW" Tag="NW" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleN" Tag="N" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleNE" Tag="NE" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleW" Tag="W" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleE" Tag="E" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleSW" Tag="SW" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleS" Tag="S" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                            <local:ResizeHandle x:Name="HandleSE" Tag="SE" Visibility="Collapsed" Width="7" Height="7" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased" PointerCaptureLost="ResizeHandle_PointerReleased">
                                <Rectangle Fill="White" Stroke="#FF5B7C99" StrokeThickness="1" />
                            </local:ResizeHandle>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Draggable splitter: Design surface <-> XAML source -->
            <local:SplitterThumb x:Name="DesignXamlSplitter" Grid.Row="2" Height="8" Background="#FFE0E0E0" VerticalAlignment="Stretch" />

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,8,8,4">
                    <TextBlock Text="XAML Source" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button
                        x:Name="FormatDocumentButton"
                        Click="FormatDocumentButton_Click"
                        Padding="6,2"
                        FontSize="11"
                        Content="Format"
                        ToolTipService.ToolTip="Reformat the XAML source with consistent indentation" />
                    <!-- Collapsed until SetXamlSourceErrors(non-empty) shows it - a second, harder-to-miss
                         cue than the Errors tab alone. Clicking it
                         jumps straight to the Errors tab. -->
                    <Button
                        x:Name="XamlSourceWarningButton"
                        Click="XamlSourceWarningButton_Click"
                        Visibility="Collapsed"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="This document has a XAML error - see the Errors tab">
                        <FontIcon Glyph="&#xE783;" Foreground="Red" FontSize="14" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- TextControlBox, not a plain TextBox: a from-scratch,
                         Win2D-rendered WinUI 3 editor control (MIT, FrozenAssassine/
                         TextControlBox-WinUI) that renders its own syntax coloring natively -
                         unlike RichEditBox, it isn't routed through any
                         non-public WinRT interface, so no `dynamic` workarounds are needed here.
                         Its own line-numbering gutter replaces the plain text pane's implicit
                         one. SelectionChanged/LostFocus/GotFocus are wired in code-behind
                         (MainWindow constructor) rather than as XAML event attributes, since
                         this control's delegate signatures differ from TextBox's own
                         (sender-only for LostFocus/GotFocus, a custom args type for
                         SelectionChanged) - implicit-typed lambdas there bind correctly without
                         needing to name those types explicitly. -->
                    <tcb:TextControlBox
                        x:Name="XamlSourceView"
                        FontFamily="Consolas"
                        FontSize="14"
                        Margin="8"
                        ShowLineNumbers="True" />

                    <!-- Line/Column/Message "grid": no real DataGrid control ships in the base
                         WinUI SDK, so this is a header row + a ListView whose rows share the
                         same 3-column layout, not a literal DataGrid - same "roll a simple
                         custom thing instead of adding a dependency" pattern as the drag
                         splitters and hover-cursor CursorGrid. -->
                    <Grid x:Name="XamlErrorsPanel" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="8,2" BorderBrush="Gray" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Line" FontWeight="Bold" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Column" FontWeight="Bold" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="Message" FontWeight="Bold" FontSize="11" />
                        </Grid>

                        <!-- IsItemClickEnabled: clicking a row (not just selecting it) jumps the
                             source view's caret there - see XamlErrorsList_ItemClick. -->
                        <ListView
                            x:Name="XamlErrorsList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="XamlErrorsList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LineText}" Foreground="Red" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding ColumnText}" Foreground="Red" FontFamily="Consolas" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="Red" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Tab strip goes BELOW its content, unlike a normal top-tabbed
                     control - WinUI's TabView always puts headers on top with no supported way to
                     move them, so this is two plain Buttons with manually managed selected/error
                     styling (UpdateXamlPaneTabButtonVisuals) rather than a real tab control. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="1" BorderBrush="Gray" BorderThickness="0,1,0,0">
                    <Button x:Name="SourceTabButton" Content="Source" Click="SourceTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" />
                    <Button x:Name="ErrorsTabButton" Content="Errors" Click="ErrorsTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: file panel + property grid -->
        <Grid Grid.Row="2" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FilePanelRow" Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PropertiesRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- Explorer, like VS's Solution Explorer: file actions live in the main menu/toolbar,
                 this panel only lists the opened folder's files, with its own panel-level actions. -->
            <Grid Grid.Row="0" Padding="8" BorderBrush="Gray" BorderThickness="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Explorer" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="ExplorerRefreshButton" Click="ExplorerRefreshButton_Click" Padding="4" IsEnabled="False" ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                        <Button x:Name="ExplorerCollapseAllButton" Click="ExplorerCollapseAllButton_Click" Padding="4" IsEnabled="False" ToolTipService.ToolTip="Collapse All">
                            <FontIcon Glyph="&#xF165;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox
                    x:Name="ExplorerSearchBox"
                    Grid.Row="1"
                    Margin="0,0,0,6"
                    FontSize="12"
                    PlaceholderText="Search Explorer"
                    IsEnabled="False"
                    TextChanged="ExplorerSearchBox_TextChanged" />

                <!-- Populated in code with TreeViewNodes (PopulateFileTree), so each item's
                     DataContext is its TreeViewNode, and the file info is its Content. -->
                <TreeView
                    x:Name="FileTreeView"
                    Grid.Row="2"
                    SelectionMode="Single"
                    DoubleTapped="FileTreeView_DoubleTapped">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{Binding Content.FullPath}">
                                <FontIcon Glyph="{Binding Content.Glyph}" Foreground="{Binding Content.IconBrush}" FontSize="14" />
                                <TextBlock Text="{Binding Content.DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </Grid>

            <!-- Draggable splitter: File panel <-> Properties -->
            <local:SplitterThumb x:Name="FilePropertiesSplitter" Grid.Row="1" Height="8" Background="#FFE0E0E0" VerticalAlignment="Stretch" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Properties/Events tab pair, on top -
                     unlike the XAML pane's Source/Errors tabs (deliberately below their content)
                     - scrolling to find
                     Events under Properties was inconvenient, so they're now two switchable
                     panels instead of one long scrolling list. -->
                <Grid Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1">
                        <Button x:Name="PropertiesTabButton" Content="Properties" Click="PropertiesTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" />
                        <Button x:Name="EventsTabButton" Content="Events" Click="EventsTabButton_Click" Padding="12,4" CornerRadius="0" BorderThickness="0" />
                    </StackPanel>

                    <!-- Same icon-toolbar pattern as the design surface's Snap to Grid button
                         - drives both the Properties and Events grids together. -->
                    <ToggleButton
                        x:Name="AlphabeticalViewToggle"
                        Grid.Column="1"
                        Padding="6"
                        Margin="0,0,2,0"
                        Checked="AlphabeticalViewToggle_Toggled"
                        Unchecked="AlphabeticalViewToggle_Toggled"
                        ToolTipService.ToolTip="Alphabetical View">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    </ToggleButton>
                </Grid>

                <StackPanel Grid.Row="1" Padding="8" Spacing="4">
                    <TextBlock x:Name="SelectionSummaryText" Text="(no selection)" Foreground="Gray" />
                </StackPanel>

                <!-- Visibility toggles on these ScrollViewers themselves (ShowPropertyPaneTab),
                     not just the StackPanels they wrap - an empty but still-Visible ScrollViewer
                     sitting on top in z-order would otherwise swallow every pointer event over
                     the whole panel, exactly what made the Properties tab appear entirely
                     read-only when this was first tried. -->
                <ScrollViewer x:Name="PropertyGridScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyGridPanel" Padding="8,0,8,8" Spacing="6" />
                </ScrollViewer>

                <ScrollViewer x:Name="EventGridScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EventGridPanel" Padding="8,0,8,8" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar, VS-style: status message on the left, then the current file's full path and
             the XAML editor's caret position (filled in code: SetStatus, UpdateDocumentStatus,
             UpdateCaretStatus). -->
        <Border Grid.Row="3" Grid.ColumnSpan="4" Background="#FF007ACC" Padding="8,2">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" Text="Ready" Foreground="White" FontSize="12" />
                <TextBlock x:Name="StatusFilePathText" Grid.Column="1" Foreground="White" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusCaretText" Grid.Column="2" Foreground="White" FontSize="12" MinWidth="110" />
            </Grid>
        </Border>
    </Grid>
</Window>
