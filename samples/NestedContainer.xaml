<Page
    x:Class="FabWinUIDesigner.Samples.NestedContainerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Canvas Width="400" Height="300" Background="White">
        <StackPanel x:Name="ButtonRow" Canvas.Left="20" Canvas.Top="20" Orientation="Horizontal" Spacing="8">
            <Button x:Name="YesButton" Content="Yes" Width="80" Height="32" />
            <Button x:Name="NoButton" Content="No" Width="80" Height="32" />
            <CheckBox x:Name="RememberCheck" Content="Remember" />
        </StackPanel>
        <TextBox x:Name="NameInput" Canvas.Left="20" Canvas.Top="80" Width="200" Height="32" />
    </Canvas>
</Page>
